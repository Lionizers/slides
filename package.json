  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "lucide-preact": "^1.71.0",
    "playwright-core": "^1.65.0",
    "preact": "^11.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
