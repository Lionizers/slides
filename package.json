{
  "name": "lionizers-slides",
  "version": "0.1.0",
  "description": "Presentations in the Lionizers CI, written as one TSX file per slide.",
  "repository": "github:lionizers/slides",
  "type": "module",
  "bin": {
    "lionizers-slides": "bin/cli.js"
  },
  "files": [
